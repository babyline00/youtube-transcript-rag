{
  "name": "youtube-transcript-rag",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a YouTube URL, ingest the transcript, and ask questions with timestamp-anchored citations that jump to the exact moment in an embedded player.",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma db push --accept-data-loss",
    "db:generate": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma generate",
    "db:migrate": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma migrate dev",
    "db:reset": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma migrate reset",
    "test": "bun test"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "youtube-transcript": "^1.2.1",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
