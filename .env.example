# SQLite database location — MUST be an absolute file path so Prisma
# writes outside of the source tree. The default below matches the path
# created by `mkdir -p db && echo "DATABASE_URL=file:$(pwd)/db/custom.db"`.
DATABASE_URL=file:/home/z/my-project/apps/13-youtube-transcript-rag/db/custom.db

# Optional: OpenAI-compatible embeddings endpoint. If unset, the app
# falls back to a deterministic hashing embedder that runs offline.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# Optional: disable the live LLM and use a deterministic mock for the
# streaming chat. Useful for offline demos / CI.
# YT_RAG_DISABLE_LLM=1
